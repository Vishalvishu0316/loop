# ==============================================================================
# Project LOOP — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values with your own:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (supports Neon, Supabase, Railway, Render, or local Postgres)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loop"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# A random 32-character string used to encrypt JWT session cookies.
# Generate one in terminal using: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-character-secret"

# Canonical URL of your application (localhost in development, production domain in deploy)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AI / LLM CONFIGURATION (Google Gemini / Anthropic Claude)
# ------------------------------------------------------------------------------
# Google Gemini API key for structured classification, Ask LOOP Q&A, and VoC report generation.
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) Model identifier override (defaults to gemini-flash-latest)
GEMINI_MODEL="gemini-flash-latest"

# (Optional) Anthropic Claude API key (if using Anthropic Claude provider)
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ------------------------------------------------------------------------------
# 4. SEED & DEMO ACCOUNT CONFIGURATION
# ------------------------------------------------------------------------------
# Seeded demo credentials for testing Role-Based Access Control (RBAC)
LOOP_DEMO_EMAIL="alex@acme.io"
LOOP_DEMO_PASSWORD="Password123!"

# Set to "true" to allow demo credentials login in production
ENABLE_DEMO_LOGIN="false"
